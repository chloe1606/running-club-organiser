# NextAuth v4: generate with `openssl rand -base64 32`. Keep stable across instances.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Explicit preview only. Must be false on the live member application.
CLUB_DEMO_MODE=true
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# SMTP settings and verified sender; leaving these unset disables email, not Google.
EMAIL_SERVER_HOST=smtp-relay.brevo.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
APPS_SCRIPT_GATEWAY_URL=https://script.google.com/macros/s/.../exec
APPS_SCRIPT_GATEWAY_SECRET=
